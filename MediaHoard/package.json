{
  "name": "mediahoard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:desktop-web": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "desktop:before-dev": "node scripts/desktop/dev-server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "node electron/dev.cjs",
    "desktop:prepare": "node scripts/desktop/prepare-runtime.mjs",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder",
    "desktop:check": "tsc --noEmit",
    "player:build-installer": "npm run desktop:build",
    "goblin-player:build-installer": "npm run desktop:build",
    "bundle:build": "npm run desktop:build"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.mediahoard.desktop",
    "productName": "MediaHoard",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!electron/resources/**",
      "public/mediahoard.ico",
      "public/mediahoard.png",
      "package.json"
    ],
    "icon": "public/mediahoard.ico",
    "extraResources": [
      {
        "from": "electron/resources/server",
        "to": "server"
      },
      {
        "from": "electron/resources/runtime",
        "to": "runtime"
      },
      {
        "from": "electron/resources/mpv",
        "to": "mpv"
      }
    ],
    "protocols": [
      {
        "name": "Goblin Player",
        "schemes": [
          "goblin"
        ]
      }
    ],
    "win": {
      "icon": "public/mediahoard.ico",
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "icon": "build/icons"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true,
    "msw@2.13.4": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}
